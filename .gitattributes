# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must stay LF even on Windows checkouts
*.sh text eol=lf
*.py text eol=lf

# recovery execve trực tiếp file này: CRLF ở shebang -> "#!/sbin/sh\r" ->
# TWRP báo "not found" và flash chết ngay dòng đầu.
bin/script2flash/META-INF/com/google/android/update-binary text eol=lf
bin/script2flash/META-INF/com/google/android/updater-script text eol=lf

*.jar binary
*.dex binary
