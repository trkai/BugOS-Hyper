# install_toolbox=true: cài app KaoriosToolbox 2.0.6.1 (priv-app) + file quyền.
#   App là mặt tiền: nó ghi cấu hình vào Settings (kaorios_pif_json,
#   kaorios_keybox_xml, kaorios_hma_config...) và nói chuyện với
#   AdvancedPolicyService nằm trong system_server.
install_toolbox=true
install_mods=true
# keep_build_region=true: giữ nguyên ro.miui.build.region của ROM (mặc định).
#   Đặt false để ép "global" như hành vi cũ - sẽ ẩn các tính năng chỉ có trên bản China
#   (ví dụ hiệu ứng xếp chồng trong Sắp xếp các mục Gần đây).
keep_build_region=true
# disable_memory_ext=true: tắt Memory Extension (内存扩展) như hành vi cũ.
#   Mặc định false = giữ nguyên của ROM (thường là bật) - tắt đi sẽ mất phần
#   swap mở rộng RAM, máy bị kill app nhiều hơn.
disable_memory_ext=false
# patch_provision_recents=true: vá Setup Wizard để bước "Sắp xếp các mục Gần đây"
#   hiện đủ 3 kiểu (Dọc / Ngang / Xếp chồng) thay vì 2.
#   Mặc định false = KHÔNG vá. Launcher đã là bản mod Kashi (UpdateFile/
#   Launcher_Replace) nên trang đầy đủ trong Cài đặt launcher vẫn có đủ 3 kiểu;
#   bước setup chỉ là hiển thị. Provision là app sống-còn của lần boot đầu nên
#   chỉ bật khi thật sự cần và đã kiểm tra lại trên máy.
patch_provision_recents=false
# fake_lock=true: bật lớp hook Kaorios 2.0.6.1 (đang BẬT).
#   Từ 2.0.6.1, hook gồm:
#     - import payload classes.dex (66 class, sha256 953a25a2…) vào framework.jar
#     - framework.jar: ActivityThread.initActivityThread, Instrumentation.initContext,
#       Settings$NameValueCache.shouldHideDevStatusFromNameValueCache
#     - services.jar : SystemServer.initSystemServer (đăng ký CustomProvider +
#       CustomKeyStoreSpi + AdvancedPolicyService), ComputerEngine.shouldHideAppListForCaller
#   BỎ các hook cũ: ApplicationPackageManager.hasSystemFeature (payload trả null)
#   và AndroidKeyStoreSpi / AndroidKeyStoreKeyPairGeneratorSpi (helper là stub).
#   Attestation giờ do keystore provider của payload lo, không sửa chain bằng tay.
#   Tên cờ giữ nguyên cho tương thích; nó KHÔNG còn là mấy dòng build.prop /
#   cmdline vendor_boot nữa (đã chứng minh vô hiệu trên máy này).
fake_lock=true
# boot_state_spoof=true: vá android.os.SystemProperties trong framework.jar để
#   get("ro.boot.verifiedbootstate") trả "green" cho MỌI app Java.
#
#   Vì sao cần: bootloader truyền androidboot.verifiedbootstate /
#   androidboot.vbmeta.device_state qua BOOTCONFIG, không qua cmdline; init áp
#   bootconfig TRƯỚC cmdline nên mọi cờ nhét vào vendor_boot hay build.prop đều
#   thua (ro.* ghi-một-lần). Đã kiểm chứng trên máy: /proc/cmdline có green
#   nhưng getprop vẫn orange.
#
#   6 prop bị thay: ro.boot.verifiedbootstate, ro.boot.vbmeta.device_state,
#   ro.secureboot.lockstate, vendor.boot.verifiedbootstate,
#   vendor.boot.vbmeta.device_state, ro.boot.flash.locked.
#   Mọi key khác đi tiếp xuống native như cũ nên init/fs_mgr không bị ảnh hưởng.
#   KHÔNG đánh lừa được attestation TEE (DroidGuard đọc bằng native).
#   Đặt false nếu nghi ngờ gây lỗi boot.
boot_state_spoof=true
# getprop_spoof=true: thay /system/bin/getprop bằng wrapper, chỉ giả 6 prop trạng
#   thái boot khi APP gọi (uid >= 10000). Shell / init / root vẫn thấy giá trị
#   thật nên debug không bị lệch.
#
#   Vì sao cần thêm lớp này: patch SystemProperties chỉ chặn được app đọc prop
#   qua Java. Đã kiểm chứng trên máy - Settings hiện "Thiết bị này đã khóa",
#   KaoriosToolbox thấy green, nhưng VNeID vẫn báo CA-E006. Trong classes.dex của
#   VNeID có "/system/bin/getprop" và không .so nào import __system_property_*,
#   tức nó chạy getprop như tiến trình con -> đọc kho prop thật, không qua Java.
#   Đó cũng là lý do resetprop làm VNeID qua được còn patch framework thì không.
#
#   Đặt false để giữ getprop gốc (khi đó chỉ còn patch Java).
getprop_spoof=true
# prop_fix_boot_state=true: ghi đè 6 prop trạng thái boot ở tầng VÙNG PROPERTY,
#   bằng init service chạy quyền root ngay trong ROM - không cần Magisk/KernelSU,
#   người dùng không phải root máy.
#
#   Đây là tầng cuối cùng và là tầng duy nhất thắng được trên base OS4. Lý do:
#   bootloader OS4 công bố androidboot.verifiedbootstate=orange TRƯỚC khi
#   userspace chạy, mà ro.* là prop ghi-một-lần. Đã thử và đều thua:
#     - vendor_boot cmdline          -> bị bỏ
#     - prop/build.prop              -> bị bỏ
#     - hook SystemProperties (Java) -> Settings hiện "đã khóa" nhưng VNeID vẫn lỗi
#     - wrapper /system/bin/getprop  -> có trong ROM, chạy đúng, VNeID vẫn lỗi
#     - resetprop 6 prop (root)      -> VNeID HẾT CA-E006, Play Store sạch
#   Bản OS3 pass được vì bootloader base OS3 KHÔNG công bố prop này, nên
#   build.prop của mod điền vào và thắng. Sang base OS4 thì hết cửa ở tầng file.
#
#   Cơ chế: bin/package/BugOSPropFix/bugos_propfix.c - tìm prop_info trong vùng
#   property, mmap lại file /dev/__properties__/* với quyền ghi, rồi ghi value +
#   bump serial. Giống resetprop của Magisk nhưng không cần Magisk.
#   Binary được biên dịch ở bước "Build prop-fix helper" trong workflow.
#
#   Sau khi flash, `adb shell getprop ro.boot.verifiedbootstate` sẽ trả green -
#   khác với patch Java (getprop vẫn orange). Đó là dấu hiệu tầng này đã chạy.
#
#   Đặt false nếu nghi ngờ gây lỗi boot (khi đó ROM về hành vi trước đó).
prop_fix_boot_state=true
# kaorios_services_hook=true: vá services.jar (SystemServer + ComputerEngine).
#
#   BẮT BUỘC true với toolbox 2.0.6.1. Payload đăng ký CustomProvider,
#   CustomKeyStoreSpi và AdvancedPolicyService bên trong
#   KaoriosHook.initSystemServer(), mà hàm đó chỉ được chèn vào
#   SystemServer.run(). Đặt false thì payload nằm trong framework.jar nhưng
#   không ai gọi initSystemServer -> app KaoriosToolbox không nói chuyện được
#   với service nào, mọi công tắc trong app thành vô tác dụng.
#
#   (Giá trị false trước đây để tái lập cấu hình Kousei tháng 4, khi chuỗi đó
#   dùng KouseiPatcher cũ. Chuỗi đó không còn tồn tại.)
kaorios_services_hook=true
# Tầng thứ ba - mod ép init.secureboot.rc đặt ro.secureboot.lockstate=locked -
#   đã bị XOÁ khỏi build (bin/modfile/UpdateFile/System_FakeLockedBootloader),
#   nên không còn cờ fake_locked_bootloader nữa. ROM giữ nguyên file rc gốc,
#   prop kẹt ở "unknown" và Cài đặt hiện đúng "Thiết bị này đã mở khóa".
#   Muốn dựng lại: git show 976d5fc:bin/modfile/UpdateFile/System_FakeLockedBootloader/update.sh
# fcm_boot_apply=true: cài init service chạy port runtime của module
#   "HyperOS FCM Notification Fix v1.4" (biplobsd) sau khi boot:
#     - greeze: tha uid GMS khỏi đóng băng 24h + unmonitor
#     - doze: whitelist GMS (user + system), appops RUN_IN_BACKGROUND/WAKE_LOCK
#     - gửi GCM_RECONNECT để GMS dựng lại socket push ngay
#     - PowerKeeper: gms_control=false, bgControl=noRestrict cho GMS/Vending
#     - settings: sáng màn hình khi có thông báo, hiện full nội dung khoá máy
#   Log: adb logcat -s BugOSFCM. Đặt false để tắt.
fcm_boot_apply=true
# brand_incremental=false: KHÔNG gắn " | BugOS" vào ro.build.version.incremental
#   (và bản system/product của nó) - đang TẮT.
#   ROM không khai báo ro.build.fingerprint nên init tự ghép nó từ chính prop
#   này. Để nguyên giá trị gốc thì fingerprint đúng định dạng:
#     Redmi/annibale/annibale:17/<id>/4.0.5.0.XPKCNXM:user/release-keys
#   Bật true sẽ thành "...4.0.5.0.XPKCNXM | BugOS:user/release-keys" -> sai định
#   dạng, Play báo "Thiết bị chưa được chứng nhận", GMS có thể không cấp token
#   FCM, và là dấu hiệu rõ nhất để app kết luận "custom ROM".
#   Không mất gì về hiển thị: dòng "Phiên bản OS" đọc ro.mi.os.version.name và
#   luôn được brand " | BugOS" bất kể cờ này (Settings_ROMInformation 124-132).
brand_incremental=false
