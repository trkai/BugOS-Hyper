# install_toolbox=true: cài app KaoriosToolbox (priv-app) + file quyền.
#   Chỉ là app xem trạng thái thiết bị, KHÔNG tự giả gì.
#   Phần fake lock đã tách sang fake_lock (bên dưới).
install_toolbox=true
install_mods=true
# keep_build_region=true: giữ nguyên ro.miui.build.region của ROM (mặc định).
#   Đặt false để ép "global" như hành vi cũ - sẽ ẩn các tính năng chỉ có trên bản China
#   (ví dụ hiệu ứng xếp chồng trong Sắp xếp các mục Gần đây).
keep_build_region=true
# disable_memory_ext=true: tắt Memory Extension (内存扩展) như hành vi cũ.
#   Mặc định false = giữ nguyên của ROM (thường là bật) - tắt đi sẽ mất phần
#   swap mở rộng RAM, máy bị kill app nhiều hơn.
disable_memory_ext=false
# patch_provision_recents=true: vá Setup Wizard để bước "Sắp xếp các mục Gần đây"
#   hiện đủ 3 kiểu (Dọc / Ngang / Xếp chồng) thay vì 2.
#   Mặc định false = KHÔNG vá. Launcher đã là bản mod Kashi (UpdateFile/
#   Launcher_Replace) nên trang đầy đủ trong Cài đặt launcher vẫn có đủ 3 kiểu;
#   bước setup chỉ là hiển thị. Provision là app sống-còn của lần boot đầu nên
#   chỉ bật khi thật sự cần và đã kiểm tra lại trên máy.
patch_provision_recents=false
# fake_locked_bootloader=true: KHÔNG ép ro.secureboot.lockstate=locked.
#   Đây là mod riêng (system_ext/etc/init/init.secureboot.rc) - phần làm trang
#   Cài đặt > Trạng thái Mở khóa Mi hiện "Thiết bị này đã khóa".
#   Đang tắt vì VNeID vẫn báo "đã mở khóa + custom ROM": fake lock không giúp
#   qua được attestation thật, mà còn tạo mâu thuẫn prop đáng ngờ.
#   Đặt true nếu muốn trang đó hiện "đã khóa" trở lại.
fake_locked_bootloader=true
# fake_lock=true: KHÔNG giả trạng thái bootloader ở tầng KouseiPatcher.
#   Khi false, ba thứ sau bị bỏ:
#     - nhét androidboot.verifiedbootstate=green ... vào cmdline vendor_boot.img
#     - vá framework.jar + services.jar chèn hook Kaorios (keystore, PackageManager,
#       SystemServer) - chính là dòng "Fake Lock: đã áp ..." trong log build
#     - nối prop/build.prop (ro.boot.verifiedbootstate=green, vbmeta.device_state=locked)
#   Vẫn giữ: app KaoriosToolbox (install_toolbox) và whitelist cust.prop, nên app
#   vẫn mở được và hiện đúng trạng thái THẬT của máy.
#   Đặt true nếu muốn bật lại fake lock.
fake_lock=true
# fcm_boot_apply=true: cài init service chạy port runtime của module
#   "HyperOS FCM Notification Fix v1.4" (biplobsd) sau khi boot:
#     - greeze: tha uid GMS khỏi đóng băng 24h + unmonitor
#     - doze: whitelist GMS (user + system), appops RUN_IN_BACKGROUND/WAKE_LOCK
#     - gửi GCM_RECONNECT để GMS dựng lại socket push ngay
#     - PowerKeeper: gms_control=false, bgControl=noRestrict cho GMS/Vending
#     - settings: sáng màn hình khi có thông báo, hiện full nội dung khoá máy
#   Log: adb logcat -s BugOSFCM. Đặt false để tắt.
fcm_boot_apply=true
# brand_incremental=false (mặc định): KHÔNG gắn " | BugOS" vào
#   ro.build.version.incremental.
#   ROM không khai báo ro.build.fingerprint nên init tự ghép nó từ prop này;
#   gắn brand vào là fingerprint sai định dạng -> Play Store báo "Thiết bị chưa
#   được chứng nhận", và cũng là nghi phạm chính làm GMS không cấp được token FCM.
#   Tắt brand ở đây thì init tự ghép fingerprint ĐÚNG, không phải đoán
#   brand/product/device (ba giá trị này không nằm trong build.prop nào).
#   Đổi lại: dòng "Phiên bản OS" có thể mất chữ " | BugOS".
#   Đặt true nếu bạn ưu tiên hiển thị hơn tính đúng của fingerprint.
brand_incremental=false
