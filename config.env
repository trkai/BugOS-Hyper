install_toolbox=true
install_mods=true
# keep_build_region=true: giữ nguyên ro.miui.build.region của ROM (mặc định).
#   Đặt false để ép "global" như hành vi cũ - sẽ ẩn các tính năng chỉ có trên bản China
#   (ví dụ hiệu ứng xếp chồng trong Sắp xếp các mục Gần đây).
keep_build_region=true
# disable_memory_ext=true: tắt Memory Extension (内存扩展) như hành vi cũ.
#   Mặc định false = giữ nguyên của ROM (thường là bật) - tắt đi sẽ mất phần
#   swap mở rộng RAM, máy bị kill app nhiều hơn.
disable_memory_ext=false
# patch_provision_recents=true: vá Setup Wizard để bước "Sắp xếp các mục Gần đây"
#   hiện đủ 3 kiểu (Dọc / Ngang / Xếp chồng) thay vì 2.
#   Mặc định false = KHÔNG vá. Launcher đã là bản mod Kashi (UpdateFile/
#   Launcher_Replace) nên trang đầy đủ trong Cài đặt launcher vẫn có đủ 3 kiểu;
#   bước setup chỉ là hiển thị. Provision là app sống-còn của lần boot đầu nên
#   chỉ bật khi thật sự cần và đã kiểm tra lại trên máy.
patch_provision_recents=false
