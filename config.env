# sukisu=true: ROM có root sẵn - SukiSU Ultra 4.3.0-r1 (LKM), tự dò KMI, chạy
#   được cho nhiều máy chứ không riêng K90.
#
#   bin/package/SukiSU/patch.sh chạy trong build.sh ngay sau khi giải nén
#   partition, TRƯỚC patchpackage.sh (bước đó tính lại vbmeta).
#
#   Nó làm:
#     1. đọc chuỗi version kernel trong boot.img -> KMI, ví dụ
#        6.6.118-android15-8-... -> android15-6.6
#     2. tải đúng lkm-aarch64-<KMI>_kernelsu.ko của v4.3.0-r1
#     3. boot-patch-v2 nhúng module vào CHÍNH kernel đó dạng capsule
#     4. cài manager com.sukisu.ultra vào product/app/SukiSUUltra
#
#   KMI không dò được -> đặt sukisu_kmi bên dưới.
#   KMI không có trong release -> build dừng và in danh sách KMI có sẵn.
#
#   ksud chạy trên host mượn của KernelSU-Next 3.4.2: SukiSU chỉ phát hành ksud
#   cho Android (PT_INTERP=/system/bin/linker64 -> không chạy trên Ubuntu).
#   Đã đối chiếu source ở đúng hai tag - lkm_image.rs (inject_image,
#   analyze_patch_sites, recover_arm64_kernel_metadata) và
#   lkm_image_bootstrap.S giống nhau 100%, tham số mặc định cũng rỗng, nên
#   capsule sinh ra là như nhau. Chi tiết ở đầu bin/package/SukiSU/patch.sh.
#
#   Không còn cờ chọn manager: bản spoofed của KernelSU Next đã chứng minh
#   không dùng được (kernel từ chối, xem commit 2a0c045), và SukiSU chỉ phát
#   hành một bản manager duy nhất.
#
#   SUSFS đã nằm sẵn trong module của SukiSU nên không cần patch riêng.
sukisu=true
# sukisu_preinstall_manager=false: KHÔNG đặt app SukiSU vào /product/app.
#   Kernel vẫn có root sẵn (module nằm trong boot.img), nhưng chưa có manager
#   nào để nói chuyện -> app không hiện trong launcher, chưa có root cho tới khi
#   người dùng mở Root Toolbox bấm "Cài".
#   true = cài sẵn app hệ thống + init service tự chuyển sang /data/app ở lần
#   boot đầu (boot xong là có root ngay, không cần chạm tay).
#   Lưu ý khi để false: lần cài đầu tiên Root Toolbox KHÔNG cài ngầm được, vì
#   nó gọi `su` mà lúc đó chưa có su. App tự rơi về installer hệ thống, người
#   dùng bấm thêm một lần "Cài đặt". Từ lần sau mới im lặng.
sukisu_preinstall_manager=false
# sukisu_kmi=: để trống thì tự dò từ kernel. Chỉ đặt khi dò sai hoặc kernel
#   không có chuỗi version đọc được. Ví dụ: android15-6.6
sukisu_kmi=
# bugos_toolbox=true: đóng gói Root Toolbox (com.khai.roottoolbox) vào product/app.
#   App tự chứa SukiSU manager (assets/sukisu_ultra.apk) và module
#   (assets/ZygiskNext+AlwaysStrongInject.zip), nên ROM không cần thêm gì.
#     - Nút "Cài": chép asset ra file rồi chạy
#       su -c "cp ... /data/local/tmp/sukisu.apk && pm install -r -d ...".
#       Đã có root thì cài ngầm; chưa có su thì rơi về installer hệ thống
#       (một lần bấm xác nhận) - giới hạn của app, không phải của ROM.
#     - Nút "Flash module": ACTION_VIEW + application/zip + content:// ->
#       SukiSU mở thẳng màn hình cài module.
#   Không cần privapp-permissions: app không xin quyền privileged nào.
#   APK do user build sẵn (ký bằng debug key), chỉ copy vào chỗ.
bugos_toolbox=true
# keep_build_region=true: giữ nguyên ro.miui.build.region của ROM (mặc định).
#   Đặt false để ép "global" như hành vi cũ - sẽ ẩn các tính năng chỉ có trên bản China
#   (ví dụ hiệu ứng xếp chồng trong Sắp xếp các mục Gần đây).
keep_build_region=true
# disable_memory_ext=true: tắt Memory Extension (内存扩展) như hành vi cũ.
#   Mặc định false = giữ nguyên của ROM (thường là bật) - tắt đi sẽ mất phần
#   swap mở rộng RAM, máy bị kill app nhiều hơn.
disable_memory_ext=false
# keep_getapps=true: KHÔNG debloat kho ứng dụng của Xiaomi, để app hệ thống vẫn
#   cập nhật được trên máy qua GetApps.
#
#   APPLIST.txt đang xoá cả cụm kho:
#     MIUISuperMarket / MiuiSuperMarket -> com.xiaomi.market (应用商店, ROM China)
#     MIUIMiPicks                       -> com.xiaomi.mipicks (GetApps, ROM Global)
#     MIUISystemAppUpdater              -> com.miui.systemAppUpdater (cập nhật app hệ thống)
#   Đo trên super.img của bản build 06112026: không còn thư mục kho nào trong
#   product/ system/ system_ext/ mi_ext -> bản ROM đang flash không có kho, nên
#   không có đường cập nhật nào, không phải lỗi mạng hay lỗi tài khoản.
#   (Phép đo đó làm trên ROM ĐÃ qua debloat, nên nó chỉ chứng minh debloat đã
#   xoá kho; base ROM có sẵn hay không thì log build mới nói được.)
#
#   Bật cờ này chỉ giữ app, không sửa gì khác. Cài bản cập nhật lên app hệ thống
#   vẫn chạy vì services.jar đã patch matchSignaturesCompat -> 1 (COREPATCH),
#   nên APK tải về không bị từ chối vì khác chữ ký với bản mod trong /product.
#
#   Lưu ý: kho China cần đăng nhập tài khoản Mi mới tải/cập nhật được, nên ROM
#   phải giữ com.xiaomi.account (đừng debloat nhóm tài khoản Mi).
#
#   Lưu ý 2: app nào ROM đã mod rồi cũng cập nhật được, và bản cập nhật sẽ THAY
#   bản mod (Settings mất branding/ưu tiên theme, Gallery/Weather mất bản mod).
#   Muốn giữ mod thì tắt tự động cập nhật cho riêng app đó trong GetApps.
keep_getapps=true
# pin_app_versions: app KHÔNG cho kho cập nhật, dù keep_getapps=true.
#
#   Vì sao cần: bản CN mà kho phục vụ cho 2 app này không chọn được tiếng Việt.
#   Đã đo trên máy 07/11 với đúng APK kho tải về:
#     - resources.arsc CÓ values-vi thật (aapt2: (vi) "Khám phá lại những bức ảnh...")
#     - system locale vi-VN, đặt app-locale lần lượt vi, vi-VN, en-US:
#         en-US -> giao diện tiếng Anh
#         vi    -> giao diện tiếng Ả Rập
#         vi-VN -> giao diện tiếng Ả Rập
#     => lỗi chọn locale của bản CN, không phải thiếu bản dịch, không phải overlay.
#   Bản global trong bin/modfile/UpdateFile/Apps_Replace/apks/ hiện tiếng Việt đúng.
#
#   Cách chặn: Apps_Replace nâng versionCode của APK đã thay lên
#   pin_app_versioncode. Kho so versionCode nên thôi chào bản mới; nếu bị ép cài
#   thì đó là downgrade và PackageManager tự từ chối. Đã kiểm trên máy: sau khi
#   nâng, cả 2 app biến khỏi danh sách 应用升级, giao diện vẫn tiếng Việt.
#
#   Hệ quả: 2 app này chỉ đổi khi build ROM mới. Muốn cho kho cập nhật lại thì
#   bỏ package khỏi danh sách (hoặc để pin_app_versions= rỗng).
#
#   APK sau khi sửa mất chữ ký v2 nhưng giữ cert Xiaomi; ROM nạp được vì
#   COREPATCH vá ApkSignatureVerifier (cùng cơ chế với Settings.apk đã mod).
pin_app_versions="com.miui.gallery com.miui.weather2"
pin_app_versioncode=2000000000
# settings_logo_height_dp: chiều cao ô logo BugOS trong Settings.
#
#   Trang "Thiết bị của tôi" đặt logo vào ImageView rộng 280dp
#   (dimen/my_device_os_logo_width) cao 40dp (dimen/my_device_os_logo_height),
#   scaleType = FIT_XY. Artwork là 3:1 nên ở ô 40dp nó bị bóp còn 42% chiều cao.
#
#   94dp = 280 / 2.98 (đúng tỉ lệ artwork) -> logo hiện 824x277 px, khít cả hai
#   chiều, không méo, to gấp 2.35 lần so với 40dp. Đo trên máy: 40dp -> 118px,
#   5dp -> 15px, 94dp -> 277px, nên dimen này chắc chắn có tác dụng.
#   Để trống để tắt, giữ 40dp như ROM gốc.
settings_logo_height_dp=94
# preinstall_gapps_apps=true: đặt sẵn 6 app Google vào product/priv-app.
#
#   Trước: base ROM chỉ có Play Store (product/priv-app/Phonesky, do gmsservices
#   chép vào) + GMS (APEX). Google, Chrome, Photos, Maps, Gmail, Drive đều phải
#   tải từng cái từ Play sau khi flash.
#
#   Nay: APK nằm trong image nên hiện sẵn. Nguồn APK là bản đang chạy trên máy
#   (đúng version người dùng đã có), lấy cả config split vì manifest khai
#   requiredSplitTypes - chép mỗi base là PackageManager từ chối cả gói.
#
#   Giá phải trả: images +~886 MB. Thư mục apks/ cũng chiếm ngần ấy trong repo.
#   App đặt sẵn thì người dùng không gỡ được, chỉ tắt được.
#   Play vẫn cập nhật bình thường (bản mới nằm ở /data/app).
#
#   Đây là app thường chứ không phải app hệ thống bắt buộc: đặt false để ROM
#   không kèm, người dùng tự cài từ Play như cũ.
#
#   Đặt false KHÔNG ảnh hưởng Play Store: Phonesky và whitelist quyền của nó
#   (product/etc/permissions/com.android.vending.xml) do gmsservices cấp, không
#   phải mod này. Máy vẫn có CH Play như app hệ thống, chỉ thiếu 6 app tiện ích.
#   Đổi lại images nhẹ đi ~886 MB.
preinstall_gapps_apps=false
# miui_region=VN: quốc gia mà ROM khai với các app Xiaomi - ro.miui.region,
#   ro.vendor.miui.region và system_ext/cust/<variant>/cust.prop.
#
#   Đây là trục KHÁC với ngôn ngữ: ngôn ngữ do ro.product.locale quyết định,
#   còn region quyết định app Xiaomi coi máy thuộc thị trường nào.
#
#   Vì sao quan trọng với kho: app Xiaomi hỏi region qua PolicyManager.isCnModel()
#   (đã đối chiếu trong bin/package/NOTIFICATION_FIX/A17/PowerKeeper.sh:
#   ro.miui.region=VN -> isCnModel()=false). Kho 应用商店 của base XPKCNXM là app
#   chỉ phục vụ thị trường China; máy khai VN thì kho không có danh sách cập nhật
#   để trả về, dù app vẫn mở và vẫn đăng nhập được.
#   => Giữ kho (keep_getapps=true) thì phải khai CN mới có cập nhật.
#
#   Đổi lại: nội dung app Xiaomi (Chủ đề, Thời tiết, Dịch vụ, Mi Cloud) theo
#   China. Ngôn ngữ giao diện vẫn tiếng Việt vì ro.product.locale=vi-VN.
#   Đặt VN để quay lại hành vi cũ (mất cập nhật qua kho).
miui_region=CN
# patch_provision_recents=true: vá Setup Wizard để bước "Sắp xếp các mục Gần đây"
#   hiện đủ 3 kiểu (Dọc / Ngang / Xếp chồng) thay vì 2.
#
#   Vì sao cần: Setup Wizard hỏi launcher qua resolver.call("getRecentsLayoutStyleNums");
#   không nhận được trả lời thì nó mặc định 2 và xoá ô "Xếp chồng". Đó là lý do
#   Cài đặt launcher thấy 3 kiểu mà lúc setup chỉ có 2.
#
#   Mod thay hẳn thân hai hàm trong com.android.provision:
#     getRecentsLayoutStyleNums -> 3, isSupportStackedLayout -> true
#   Hỏng ở bất kỳ bước nào thì nó giữ nguyên APK gốc và đi tiếp (exit 0), không
#   làm chết app. Bản gốc của hai file được lưu ở documentation/provision_src.
#
#   ĐANG BẬT TRÊN DEV ĐỂ THỬ. main vẫn false. Provision là app sống-còn của lần
#   boot đầu, nên chỉ chuyển sang main sau khi bản dev boot và setup chạy hết.
patch_provision_recents=true
# boot_state_spoof=true: vá android.os.SystemProperties trong framework.jar để
#   get("ro.boot.verifiedbootstate") trả "green" cho MỌI app Java.
#
#   Vì sao cần: bootloader truyền androidboot.verifiedbootstate /
#   androidboot.vbmeta.device_state qua BOOTCONFIG, không qua cmdline; init áp
#   bootconfig TRƯỚC cmdline nên mọi cờ nhét vào vendor_boot hay build.prop đều
#   thua (ro.* ghi-một-lần). Đã kiểm chứng trên máy: /proc/cmdline có green
#   nhưng getprop vẫn orange.
#
#   6 prop bị thay: ro.boot.verifiedbootstate, ro.boot.vbmeta.device_state,
#   ro.secureboot.lockstate, vendor.boot.verifiedbootstate,
#   vendor.boot.vbmeta.device_state, ro.boot.flash.locked.
#   Mọi key khác đi tiếp xuống native như cũ nên init/fs_mgr không bị ảnh hưởng.
#   KHÔNG đánh lừa được attestation TEE (DroidGuard đọc bằng native).
#   Đặt false nếu nghi ngờ gây lỗi boot.
boot_state_spoof=true
# getprop_spoof=true: thay /system/bin/getprop bằng wrapper, chỉ giả 6 prop trạng
#   thái boot khi APP gọi (uid >= 10000). Shell / init / root vẫn thấy giá trị
#   thật nên debug không bị lệch.
#
#   Vì sao cần thêm lớp này: patch SystemProperties chỉ chặn được app đọc prop
#   qua Java. Đã kiểm chứng trên máy - Settings hiện "Thiết bị này đã khóa",
#   nhưng VNeID vẫn báo CA-E006. Trong classes.dex của VNeID có
#   "/system/bin/getprop" và không .so nào import __system_property_*, tức nó
#   chạy getprop như tiến trình con -> đọc kho prop thật, không qua Java.
#   Đó cũng là lý do resetprop làm VNeID qua được còn patch framework thì không.
#
#   Có root thì lớp này không còn cần thiết: resetprop ghi thẳng kho prop nên
#   mọi tiến trình đều thấy giá trị mới. Giữ lại vì ROM chưa kèm module KSU nào.
#
#   Đặt false để giữ getprop gốc (khi đó chỉ còn patch Java).
getprop_spoof=true
# prop_fix_boot_state=true: ghi đè 6 prop trạng thái boot ở tầng VÙNG PROPERTY,
#   bằng init service chạy quyền root ngay trong ROM - không cần Magisk/KernelSU,
#   người dùng không phải root máy.
#
#   Đây là tầng cuối cùng và là tầng duy nhất thắng được trên base OS4. Lý do:
#   bootloader OS4 công bố androidboot.verifiedbootstate=orange TRƯỚC khi
#   userspace chạy, mà ro.* là prop ghi-một-lần. Đã thử và đều thua:
#     - vendor_boot cmdline          -> bị bỏ
#     - prop/build.prop              -> bị bỏ
#     - hook SystemProperties (Java) -> Settings hiện "đã khóa" nhưng VNeID vẫn lỗi
#     - wrapper /system/bin/getprop  -> có trong ROM, chạy đúng, VNeID vẫn lỗi
#     - resetprop 6 prop (root)      -> VNeID HẾT CA-E006, Play Store sạch
#   Bản OS3 pass được vì bootloader base OS3 KHÔNG công bố prop này, nên
#   build.prop của mod điền vào và thắng. Sang base OS4 thì hết cửa ở tầng file.
#
#   Cơ chế: bin/package/BugOSPropFix/bugos_propfix.c - tìm prop_info trong vùng
#   property, mmap lại file /dev/__properties__/* với quyền ghi, rồi ghi value +
#   bump serial. Giống resetprop của Magisk nhưng không cần Magisk.
#   Binary được biên dịch ở bước "Build prop-fix helper" trong workflow.
#
#   Sau khi flash, `adb shell getprop ro.boot.verifiedbootstate` sẽ trả green -
#   khác với patch Java (getprop vẫn orange). Đó là dấu hiệu tầng này đã chạy.
#
#   Đặt false nếu nghi ngờ gây lỗi boot (khi đó ROM về hành vi trước đó).
prop_fix_boot_state=true
# fcm_boot_apply=true: cài init service chạy port runtime của module
#   "HyperOS FCM Notification Fix v1.4" (biplobsd) sau khi boot:
#     - greeze: tha uid GMS khỏi đóng băng 24h + unmonitor
#     - doze: whitelist GMS (user + system), appops RUN_IN_BACKGROUND/WAKE_LOCK
#     - gửi GCM_RECONNECT để GMS dựng lại socket push ngay
#     - PowerKeeper: gms_control=false, bgControl=noRestrict cho GMS/Vending
#     - settings: sáng màn hình khi có thông báo, hiện full nội dung khoá máy
#   Log: adb logcat -s BugOSFCM. Đặt false để tắt.
fcm_boot_apply=true
# brand_incremental=false: KHÔNG gắn " | BugOS" vào ro.build.version.incremental
#   (và bản system/product của nó) - đang TẮT.
#   ROM không khai báo ro.build.fingerprint nên init tự ghép nó từ chính prop
#   này. Để nguyên giá trị gốc thì fingerprint đúng định dạng:
#     Redmi/annibale/annibale:17/<id>/4.0.5.0.XPKCNXM:user/release-keys
#   Bật true sẽ thành "...4.0.5.0.XPKCNXM | BugOS:user/release-keys" -> sai định
#   dạng, Play báo "Thiết bị chưa được chứng nhận", GMS có thể không cấp token
#   FCM, và là dấu hiệu rõ nhất để app kết luận "custom ROM".
#   Không mất gì về hiển thị: dòng "Phiên bản OS" đọc ro.mi.os.version.name và
#   luôn được brand " | BugOS" bất kể cờ này (Settings_ROMInformation 124-132).
brand_incremental=false
# debloat_securitycenter=true: xoá hẳn 手机管家 (com.miui.securitycenter).
#
#   Đo trên máy 08/11 (13.6.5-261003.0.1):
#     - `pm disable-user` bị MIUI chặn: "Cannot disable miui core packages"
#       -> chỉ xoá được lúc build, không tắt được sau khi flash.
#     - KHÔNG có cờ coreApp trong dumpsys nên máy vẫn boot khi thiếu.
#     - 50 tham chiếu từ Settings, trong đó có content://...securitycenter.provider,
#       remoteprovider, ADB_INSTALL_VERIFY, WNCheckManager.
#     - provider `authority=antispam` đang được system_server (uid 1000) giữ.
#     - PackageInstaller KHÔNG tham chiếu (grep dex 0 hit) -> cài app vẫn chạy.
#
#   MẤT khi bật:
#     icon 手机管家, quản lý quyền ứng dụng, bảo vệ quyền riêng tư, khoá app,
#     Power Center / tiết kiệm pin, quản lý dữ liệu mạng + tường lửa, dọn rác,
#     Game Booster, chống spam SMS, xác minh cài đặt qua ADB.
#     Vài mục trong Cài đặt trỏ tới nó sẽ báo "không tìm thấy ứng dụng".
#
#   Hai app dưới đây an toàn hơn nhiều, đã có sẵn trong APPLIST không cần cờ:
#     com.miui.guardprovider      (AI Guard: phát hiện lừa đảo qua điện thoại/VoIP)
#     com.mobiletools.systemhelper (Baidu Location SDK 9.5.2.1 + telemetry)
debloat_securitycenter=false
# block_tracking_hosts=true: chặn 4 domain giám sát của Trung tâm An toàn ở tầng
#   DNS, bằng /system/etc/hosts. Giữ app lại nên KHÔNG mất 15 module bên trong
#   (quyền ứng dụng, pin, tường lửa, cảnh báo động đất, khoá app, Game Turbo...).
#
#   Danh sách mặc định + chứng cứ (đọc từ APK, không suy đoán):
#     flash.sec.miui.com                 POST /user/cat /detect/app
#                                        -> android_id, device, carrier, apps
#     fraud-detection.engine.miui.com    GET /nfc/antifraud/config
#     eps.caict.ac.cn                    POST /eps/collect -> GPS + số điện thoại
#     gateway-papa.cloud.weizhi.com      POST /papa/upload -> số gọi + thời gian
#
#   Đã kiểm hosts có tác dụng trên máy (a17): bind-mount file rồi ping 4 domain
#   đều ra 127.0.0.1, mở 手机管家 không crash.
#
#   Đổi danh sách: block_hosts="domain1 domain2" (thay hẳn danh sách mặc định).
#   Tắt: block_tracking_hosts=false.
block_tracking_hosts=true
