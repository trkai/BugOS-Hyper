<?xml version="1.0" encoding="utf-8"?>
<!--
  BugOS Toolbox - app hệ thống, chỉ làm 2 việc:
    1. cài SukiSU Ultra manager thành app dữ liệu (im lặng, nhờ INSTALL_PACKAGES)
    2. mở màn hình flash module của SukiSU với file module đóng sẵn trong ROM

  Vì sao phải là app hệ thống (priv-app): INSTALL_PACKAGES là permission
  signature|privileged, chỉ cấp được cho app nằm trong /product/priv-app và có
  tên trong privapp-permissions. Không có nó thì mỗi lần cài lại phải bấm xác
  nhận, mất luôn ý nghĩa "tự cài ngầm".
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bugos.toolbox"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:directBootAware="true"
        android:icon="@drawable/ic_launcher"
        android:label="BugOS Toolbox"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="BugOS Toolbox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Nhận kết quả của PackageInstaller. Không export. -->
        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <!--
          Cấp file module.zip cho SukiSU đọc qua content://.
          SukiSU khai báo ACTION_VIEW với mimeType application/zip + scheme
          content, nên chỉ cần đưa đúng uri là nó mở thẳng màn hình flash.
        -->
        <provider
            android:name=".ModuleProvider"
            android:authorities="com.bugos.toolbox.module"
            android:exported="true"
            android:grantUriPermissions="true" />
    </application>
</manifest>
