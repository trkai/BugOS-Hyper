# ---------------------------------------------------------------------------
# Prop cho PlayIntegrityFix / Fake Lock (KouseiPatcher).
# File này được NỐI vào system/system/build.prop khi install_toolbox=true.
#
# Lưu ý: ro.* là prop ghi-một-lần. Nếu ROM đã có cùng key ở dòng trước đó thì
# giá trị ở đây KHÔNG có tác dụng. Vì vậy không thêm key trùng lặp nữa.
# Đã dedupe và comment các prop không thể set qua build.prop.
# ---------------------------------------------------------------------------

#PlayIntegrityFix
ro.boot.verifiedbootstate=green
vendor.boot.verifiedbootstate=green
vendor.boot.vbmeta.device_state=locked
ro.boot.veritymode=enforcing
ro.boot.vbmeta.device_state=locked
ro.boot.flash.locked=1
ro.boot.warranty_bit=0
ro.warranty_bit=0
ro.debuggable=0
ro.secure=1
ro.secureboot.devicelock=1
ro.build.type=user
ro.build.keys=release-keys
ro.build.tags=release-keys
ro.vendor.boot.warranty_bit=0
ro.vendor.warranty_bit=0
sys.oem_unlock_allowed=0
ro.oem_unlock_supported=0
# (bỏ) init.svc.flash_recovery=stopped  <- init.svc.* là prop runtime, build.prop không set được
ro.boot.realmebootstate=green
ro.boot.realme.lockstate=1
ro.crypto.state=encrypted
# (bỏ) init.svc.adbd=stopped  <- init.svc.* là prop runtime, build.prop không set được
ro.miui.has_gmscore=1
ro.opa.eligible_device=true
ro.miui.support_miui_ime_bottom=1
persist.sys.zk.multi=1
