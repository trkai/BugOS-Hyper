# BugOS - port phần runtime của HyperOS FCM Notification Fix v1.4 (biplobsd).
#
# Module gốc là Magisk module nên chạy script bằng magiskd. ROM không có magiskd,
# nên dùng init service: chạy nền (oneshot) sau khi boot xong, uid root, seclabel
# u:r:su:s0 - đúng cặp (uid root + domain su) mà /system/etc/init/apexd.rc trong
# chính ROM này đang dùng cho script shell của nó.
#
# Vì sao phải là service chứ không phải `exec`: exec trong init là đồng bộ, init
# sẽ đứng chờ script (có sleep 5/15s) -> chậm boot. service chạy nền nên không.
#
# Nếu domain su không cho phép (SELinux enforcing), init sẽ log lỗi và bỏ qua,
# máy vẫn boot bình thường - không có rủi ro boot loop.

service bugos_fcm_boot /system/bin/sh /system_ext/etc/bugos_fcm_boot.sh
    class late_start
    user root
    group root system
    oneshot
    seclabel u:r:su:s0
    disabled

on property:sys.boot_completed=1
    start bugos_fcm_boot
