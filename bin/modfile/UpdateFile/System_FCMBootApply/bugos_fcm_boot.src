#!/system/bin/sh
# =============================================================================
# BugOS - port phần runtime của HyperOS FCM Notification Fix v1.4 (biplobsd)
#
# Chạy bởi init service bugos_fcm_boot (uid root, seclabel u:r:su:s0) sau khi
# sys.boot_completed=1. Gồm 4 phần, đúng thứ tự module gốc:
#   1. GMS surgical exemption  - không bao giờ bị greeze/doze đóng băng
#   2. GCM_RECONNECT           - ép GMS dựng lại socket MCS ngay
#   3. PowerKeeper disarm      - tắt gms_control + bgControl=noRestrict
#   4. Settings mặc định       - sáng màn hình khi có thông báo, hiện full nội dung
#
# Mọi bước đều log ra logcat với tag BugOSFCM để kiểm tra được sau khi flash:
#   adb logcat -s BugOSFCM
# =============================================================================

TAG="BugOSFCM"
LOG_TAG_FILE="/data/system/bugos_fcm_defaults_applied"

log_msg() { log -t "$TAG" "$*"; }

log_msg "start (uid=$(id -u), ctx=$(cat /proc/self/attr/current 2>/dev/null))"

# -----------------------------------------------------------------------------
# 0. Kích hoạt CH Play và dịch vụ Google (com.android.vending, gms, gsf)
#    Trên ROM China, 3 gói này mặc định bị disable, khiến CH Play không hiện icon.
# -----------------------------------------------------------------------------
for pkg in com.android.vending com.google.android.gms com.google.android.gsf; do
    pm enable "$pkg" >/dev/null 2>&1
    pm enable --user 0 "$pkg" >/dev/null 2>&1
done
log_msg "google services enabled"

# -----------------------------------------------------------------------------
# 1. GMS surgical exemption
# -----------------------------------------------------------------------------
GMS_UID=$(pm list packages -U com.google.android.gms 2>/dev/null \
    | grep -E '^package:com\.google\.android\.gms ' | grep -o 'uid:[0-9]*' \
    | cut -d: -f2 | head -n1)
[ -z "$GMS_UID" ] && GMS_UID=$(stat -c %u /data/data/com.google.android.gms 2>/dev/null)

if [ -n "$GMS_UID" ]; then
    log_msg "gms uid=$GMS_UID"

    # greeze: tha uid khỏi đóng băng trong 24h và bỏ theo dõi
    cmd greezer thuid "$GMS_UID" 86400000 >/dev/null 2>&1 && log_msg "greezer thuid ok" || log_msg "greezer thuid FAILED"
    cmd greezer unmonitor "$GMS_UID" >/dev/null 2>&1 && log_msg "greezer unmonitor ok" || log_msg "greezer unmonitor FAILED"

    # doze: whitelist cả user và system
    cmd deviceidle whitelist "+com.google.android.gms" >/dev/null 2>&1 && log_msg "deviceidle whitelist ok" || log_msg "deviceidle whitelist FAILED"
    cmd deviceidle sys-whitelist "+com.google.android.gms" >/dev/null 2>&1 && log_msg "deviceidle sys-whitelist ok" || log_msg "deviceidle sys-whitelist FAILED"

    # appops: cho phép chạy nền và giữ wakelock
    for op in RUN_IN_BACKGROUND RUN_ANY_IN_BACKGROUND 10008 WAKE_LOCK; do
        cmd appops set com.google.android.gms "$op" allow >/dev/null 2>&1 \
            && log_msg "appops $op ok" || log_msg "appops $op FAILED"
    done

    # cgroup freezer: bỏ đóng băng nếu đang bị (cgroup v1 + v2)
    for fz in "/sys/fs/cgroup/apps/uid_${GMS_UID}/cgroup.freeze" \
              "/sys/fs/cgroup/uid_${GMS_UID}/cgroup.freeze" \
              "/sys/fs/cgroup/apps/uid_${GMS_UID}"/*/cgroup.freeze \
              "/sys/fs/cgroup/uid_${GMS_UID}"/*/cgroup.freeze \
              "/dev/freezer/apps/uid_${GMS_UID}/freezer.state"; do
        [ -f "$fz" ] || continue
        case "$fz" in
            *freezer.state) echo "THAWED" > "$fz" 2>/dev/null ;;
            *)              echo 0 > "$fz" 2>/dev/null ;;
        esac
    done
else
    log_msg "gms uid not resolved - skip exemption"
fi

# -----------------------------------------------------------------------------
# 2. GCM_RECONNECT - ép GMS dựng lại kết nối push ngay sau boot
# -----------------------------------------------------------------------------
am broadcast -a com.google.android.intent.action.GCM_RECONNECT \
    -p com.google.android.gms >/dev/null 2>&1 \
    && log_msg "GCM_RECONNECT sent" || log_msg "GCM_RECONNECT FAILED"

# -----------------------------------------------------------------------------
# 3. PowerKeeper: tắt gms_control + bgControl=noRestrict cho GMS/Vending
#    (module gốc retry 0/5/15s vì PowerKeeper trên ROM China khởi động muộn)
# -----------------------------------------------------------------------------
pk_disarm() {
    content call --uri content://com.miui.powerkeeper.configure/SimpleSettings/misc \
        --method PUT_misc --arg gms_control --extra value:s:false >/dev/null 2>&1

    for p in com.google.android.gms com.android.vending; do
        content update --uri content://com.miui.powerkeeper.configure/userTable \
            --bind bgControl:s:noRestrict \
            --where "pkgName='${p}' AND userId=0" >/dev/null 2>&1
        has=$(content query --uri content://com.miui.powerkeeper.configure/userTable \
            --where "pkgName='${p}' AND userId=0" 2>/dev/null | grep -c 'pkgName=')
        if [ "$has" -eq 0 ]; then
            content insert --uri content://com.miui.powerkeeper.configure/userTable \
                --bind pkgName:s:"${p}" --bind userId:i:0 \
                --bind bgControl:s:noRestrict >/dev/null 2>&1
        fi
    done

    # chain của GmsObserver (nếu bản PowerKeeper nào có dùng)
    iptables -F gms_wall >/dev/null 2>&1
    ip6tables -F gms_wall >/dev/null 2>&1
}

for d in 0 5 15; do
    [ "$d" -gt 0 ] && sleep "$d"
    pk_disarm
done
log_msg "powerkeeper disarm done"

# -----------------------------------------------------------------------------
# 4. Settings mặc định - chỉ áp một lần, không ghi đè lựa chọn sau này của người dùng
# -----------------------------------------------------------------------------
if [ ! -f "$LOG_TAG_FILE" ]; then
    ok=1
    settings put secure notification_animation_style screen_on 2>/dev/null || ok=0
    settings put system wake_up_for_notification 1 2>/dev/null || ok=0
    settings put secure lock_screen_wake_up_for_notification 1 2>/dev/null || ok=0
    settings put system wakeup_for_keyguard_notification 1 2>/dev/null || ok=0
    settings put secure full_screen_aod_notification 1 2>/dev/null || ok=0
    settings put secure lock_screen_show_notifications 1 2>/dev/null || ok=0
    settings put secure lock_screen_allow_private_notifications 1 2>/dev/null || ok=0
    settings put system pref_key_enable_notification_body 1 2>/dev/null || ok=0
    settings put secure lock_screen_show_only_unseen_notifications 0 2>/dev/null || ok=0

    if [ "$ok" -eq 1 ]; then
        touch "$LOG_TAG_FILE" 2>/dev/null
        log_msg "notification settings applied"
    else
        log_msg "notification settings PARTIAL - will retry next boot"
    fi
else
    log_msg "notification settings already applied"
fi

log_msg "done"
