<?xml version='1.0' encoding='utf-8' ?>
<com.google.android.material.card.MaterialCardView android:layout_width="fill_parent"
                      android:layout_height="wrap_content"
                      android:minHeight="143.0dp"
                      android:layout_marginBottom="8.0dp"
                      android:layout_marginStart="4.0dp"
                      android:layout_marginEnd="12.0dp"
                      app:cardBackgroundColor="@color/my_device_info_item_background_color"
                      app:cardCornerRadius="19.0dp"
                      app:cardElevation="0.0dp"
                      app:rippleColor="?android:attr/colorControlHighlight" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
  <LinearLayout android:gravity="start"
                android:orientation="vertical"
                android:paddingBottom="16.0dp"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16.0dp">
    <com.kashi.settings.view.StorageProgressBar android:id="@id/storage_progress_kchi"
                          android:layout_width="fill_parent"
                          android:layout_height="38.0dp"
                          android:layout_marginTop="16.0dp"
                          android:max="100"
                          android:indeterminate="false"
                          android:progressDrawable="@drawable/oos_progress_drawable"
                          android:scaleY="1.0"
                          android:layout_marginHorizontal="5.0dp"
                          style="?attr/progressBarHorizontalStyle" />
    <TextView android:textSize="16.0sp"
              android:textColor="?android:attr/textColorPrimary"
              android:id="@id/title"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="12.0dp"
              android:lineSpacingMultiplier="1.1"
              android:fontFamily="@android:string/config_headlineFontFamilyMedium"
              android:textAlignment="viewStart" />
    <!-- BugOS: summary 1 dong + ellipsize. Truoc day wrap_content + khong
         gioi han dong nen chuoi "37,2GB/264GB (8GB co mo rong luu tru)" xuong
         2 dong, day card Bo nho cao hon card Ten thiet bi 40px (do tren may
         22/11: 293px vs 333px). width phai la fill_parent thi ellipsize moi
         co tac dung. -->
    <TextView android:textSize="14.0sp"
              android:textColor="?android:attr/textColorSecondary"
              android:id="@id/summary"
              android:layout_width="fill_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="4.0dp"
              android:lineSpacingMultiplier="1.15"
              android:maxLines="1"
              android:ellipsize="end"
              android:textAlignment="viewStart" />
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>