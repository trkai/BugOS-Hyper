# BugOS build target: Android 17 (HyperOS 4) - EXPERIMENTAL
# Được đọc bởi bin/ddevice/target_check.sh ngay sau khi bung ROM.
#
# CHƯA ĐƯỢC KIỂM CHỨNG TRÊN ROM ANDROID 17 THẬT.
# Toàn bộ nhánh A17 được port từ A16 (jar_patcher_a17.sh là bản copy có đổi
# API_LEVEL + thêm guard). Nếu ROM A17 đổi cấu trúc framework thì build sẽ
# DỪNG với lỗi rõ ràng, không tạo ra ROM hỏng.
#
# Khi có ROM A17 thật: build thử -> nếu các bước patch báo "missing patched jar"
# thì cần cập nhật anchor trong jar_patcher_a17.sh rồi mới đặt TARGET_STATUS=stable.

TARGET_ANDROID=17
TARGET_SDK=37
TARGET_STATUS=experimental
TARGET_HYPEROS="OS4 OS5 OS6"

REQUIRED_FILES="
bin/package/COREPATCH/jar_patcher_a17.sh
bin/package/NOTIFICATION_FIX/A17/RUN.SH
bin/package/NOTIFICATION_FIX/A17/PowerKeeper.sh
bin/package/NOTIFICATION_FIX/A17/patchMIUIServices.sh
bin/package/NOTIFICATION_FIX/A17/patch_miui_services_a17.py
"
