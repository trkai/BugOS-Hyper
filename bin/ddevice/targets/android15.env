# BugOS build target: Android 15 (HyperOS 2 / HyperOS 3) - STABLE
# Được đọc bởi bin/ddevice/target_check.sh ngay sau khi bung ROM.
#
# Vì sao vẫn cần nhánh này dù đã có A16/A17: Xiaomi phát hành HyperOS 3 cho một
# số máy nền Android 15 (ví dụ marble / Redmi Note 12 Turbo, OS3.0.5.0.VMRCNXM).
# Những máy đó báo androidver=15, nên nếu không có file này build sẽ dừng ở
# bước kiểm tra target dù jar_patcher_a15.sh đã có sẵn.
#
# Bộ patch dùng lại đúng nhánh A15 cũ: jar_patcher_a15.sh (API_LEVEL=35) +
# NOTIFICATION_FIX/A15. Không có gì mới phải bịa thêm.

TARGET_ANDROID=15
TARGET_SDK=35
TARGET_STATUS=stable
TARGET_HYPEROS="OS2 OS3"

# Những file PHẢI tồn tại thì mới cho build. Thiếu 1 file = dừng, không build ROM nửa vời.
REQUIRED_FILES="
bin/package/COREPATCH/jar_patcher_a15.sh
bin/package/NOTIFICATION_FIX/A15/RUN.SH
bin/package/NOTIFICATION_FIX/A15/PowerKeeper.sh
bin/package/NOTIFICATION_FIX/A15/patchMIUIServices.sh
"
