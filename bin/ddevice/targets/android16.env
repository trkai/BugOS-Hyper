# BugOS build target: Android 16 (HyperOS 3) - STABLE
# Được đọc bởi bin/ddevice/target_check.sh ngay sau khi bung ROM.
# Sửa file này = thay đổi điều kiện build được chấp nhận cho Android 16.

TARGET_ANDROID=16
TARGET_SDK=36
TARGET_STATUS=stable
TARGET_HYPEROS="OS1 OS2 OS3 OS4"

# Những file PHẢI tồn tại thì mới cho build. Thiếu 1 file = dừng, không build ROM nửa vời.
REQUIRED_FILES="
bin/package/COREPATCH/jar_patcher_a16.sh
bin/package/NOTIFICATION_FIX/A16/RUN.SH
bin/package/NOTIFICATION_FIX/A16/PowerKeeper.sh
bin/package/NOTIFICATION_FIX/A16/patchMIUIServices.sh
"
